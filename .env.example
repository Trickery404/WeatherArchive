# WeatherArchive - Environment Variables Example
# Kopiere diese Datei nach .env und fuelle deine echten Werte ein
# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR_ACCOUNT_ID
# S3 Buckets
RAW_BUCKET=weatherarchive-raw-YOUR_ACCOUNT_ID
PROCESSED_BUCKET=weatherarchive-processed-YOUR_ACCOUNT_ID
VIDEO_BUCKET=weatherarchive-videos-YOUR_ACCOUNT_ID
DEPLOY_BUCKET=weatherarchive-deploy-YOUR_ACCOUNT_ID
# PostgreSQL RDS
POSTGRES_HOST=your-db-endpoint.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=weatherarchive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
# PostgreSQL Environment Variables (fuer Lambda)
PG_HOST=your-db-endpoint.rds.amazonaws.com
PG_DB=weatherarchive
PG_USER=postgres
PG_PASSWORD=YOUR_DB_PASSWORD
# Redis Cloud
REDIS_HOST=redis-XXXXX.c240.us-east-1-3.ec2.cloud.redislabs.com
REDIS_PORT=XXXXX
REDIS_USERNAME=default
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
# API Configuration
API_KEY=YOUR_GENERATED_API_KEY
