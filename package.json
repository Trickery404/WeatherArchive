{
	"name": "weatherarchive",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:backend": "node src/backend/dev-server.js",
		"dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"docker:tar": "docker build -t weatherarchive:latest . && docker save -o svelte-docker-latest.tar weatherarchive:latest",
		"test": "vitest run",
		"test:watch": "vitest",
		"generate:testdata": "node docs/backend/testdata/generate-testdata.js",
		"generate:images": "node scripts/generate-unique-images.js",
		"deploy": "npm run build && powershell -ExecutionPolicy Bypass -File deploy-to-s3.ps1"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/node": "^22",
		"autoprefixer": "^10.4.21",
		"concurrently": "^9.1.2",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^3.4.13",
		"typescript": "^5.9.2",
		"vite": "^7.1.12"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.712.0",
		"@aws-sdk/client-eventbridge": "^3.712.0",
		"@aws-sdk/client-s3": "^3.712.0",
		"@aws-sdk/client-sqs": "^3.712.0",
		"@aws-sdk/s3-request-presigner": "^3.712.0",
		"chart.js": "^4.5.1",
		"dotenv": "^17.2.3",
		"fluent-ffmpeg": "^2.1.3",
		"ioredis": "^5.9.2",
		"lodash.defaults": "^4.2.0",
		"lodash.flatten": "^4.4.0",
		"lodash.isarguments": "^3.1.0",
		"lodash.merge": "^4.6.2",
		"pg": "^8.17.1",
		"sharp": "^0.33.5",
		"typescript-eslint": "^8.45.0",
		"vitest": "^2.1.8"
	}
}
